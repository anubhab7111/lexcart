# Copy to server/.env and fill in. Never commit the real .env file.

# --- Required ---

# PostgreSQL connection string. Local setup: db/role `lawweb`/`lawweb`,
# database `lexcart`.
DATABASE_URL=postgresql://lawweb:lawweb@127.0.0.1:5432/lexcart

# Secret used to sign/verify JWTs. The app refuses to start without this
# unless DEBUG=true (see app/security.py) — a missing secret used to fall
# back to a hardcoded literal, letting anyone forge a valid auth token.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Razorpay TEST-mode keys (https://dashboard.razorpay.com -> test mode).
# Leave blank to run the built-in mock gateway: identical code paths and
# audit trail, labeled mock ids, no network calls.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Optional ---

# Frontend origins allowed to call this API (comma-separated). Defaults
# already cover the Vite dev server (client/vite.config.ts: port 3000) and
# Vite's own default (5173) — override only for a LAN IP or deployed origin.
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# When true, allows the insecure JWT_SECRET fallback and includes raw
# exception text in 500 responses. Leave false for anything demo-facing.
# DEBUG=false

HOST=0.0.0.0
PYTHON_PORT=8000

OLLAMA_BASE_URL=http://localhost:11434

# Optional: live case-law search via Indian Kanoon.
# INDIAN_KANOON_API_KEY=

# Optional: LLM-as-judge for the RAG eval script (tests/test_chatbot.py).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Optional: Cloudflare R2 (S3-compatible) for the document vault. If unset,
# vault storage falls back to local disk under app/data/vault/.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=lawweb-vault
# R2_ENDPOINT_URL=

# Optional: SMTP for email notifications. Left blank, notifications are
# logged instead of sent — safe local-dev default.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=no-reply@lawweb.local

# Optional: comma-separated emails allowed to act as the merchant (approve/
# reject campaigns, read the full audit trail). Left blank, any signed-in
# user is treated as the merchant — the buildathon demo has one operator.
# MERCHANT_EMAILS=

# Optional: secret Razorpay signs webhook payloads with (dashboard -> test
# mode -> Webhooks). Leave blank to derive a mock secret from JWT_SECRET.
# RAZORPAY_WEBHOOK_SECRET=
